# Public site origin. Required in production for Stripe redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Temporary public homepage. Set false to restore the full leaderboard homepage.
LAUNCH_MODE=true

# Set true only when intentionally previewing shared demo data.
DEMO_MODE=false

# Firebase browser SDK configuration used only by the admin login form.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Browser SDK URL for local Auth emulator use only.
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099

# Firebase Admin SDK credentials. Keep these server-only.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"
FIREBASE_ADMIN_UID=

# Random server-only value used to hash checkout rate-limit keys.
RATE_LIMIT_SALT=

# Stripe server credentials.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional local emulator configuration.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
